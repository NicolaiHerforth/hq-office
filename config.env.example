# HQ Office configuration. KEY=VALUE per line; lines starting with # are ignored.
# An empty value means "use the default". Restart after a change:
#   herdr plugin action invoke hq-office.reload

# The herdr agent name of your HQ lane: the agent that asks you questions and
# receives your answers and notes. Run `herdr agent list` to see the names.
# If left empty, the server falls back to an agent named "hq".
HUD_HQ_AGENT=

# HQ is taught to reply through the HUD, since you read the page, not its terminal:
# every message typed into HQ ends with a one-line reminder (HUD_HQ_HINT=0 leaves it out),
# and each new HQ session gets the HQ guide once (HUD_HQ_GREET=0 turns that off).
HUD_HQ_HINT=
HUD_HQ_GREET=
# When a lane's agent stops at a permission prompt or a question in herdr, HQ is told once (HUD_HQ_BLOCKED=0: never).
HUD_HQ_BLOCKED=

# Your name: on the desk sign, on the default hero, and in the notes and answers
# HQ is sent. Empty means "the owner".
HUD_OWNER=

# Port and address the server listens on. Defaults: 4747 and 127.0.0.1.
# Keep the host on 127.0.0.1 unless you know why you want otherwise.
HUD_PORT=
HUD_HOST=

# Extra page addresses that may use the page, such as your phone through tailscale serve:
# HUD_TRUSTED_ORIGINS=https://name.tailnet.ts.net:4747  (comma-separated, exact). Secrets stay this machine's own page only.
HUD_TRUSTED_ORIGINS=

# GitHub repo (owner/repo) used to link lanes to their pull requests.
HUD_GITHUB_REPO=

# Linear workspace slug used to link lanes to their issues.
HUD_LINEAR_WORKSPACE=

# Name of this machine in the room. Default: local.
HUD_LOCAL_MACHINE=

# Comma-separated herdr machines to poll for agents. Default: just this machine.
HUD_MACHINES=

# Path to the herdr binary. Default: herdr, found on PATH.
HERDR_BIN=

# Orchestration registry: a JSON file naming which orchestrator (or PM lane) answers which lane, so a
# request is filed to the one who must answer it. Shape: {"orchestrators": {"NAME": {"lanes": {"<machine> <pane>": "label"}}},
# "under": {"<machine> <pane>": ["<PM machine> <PM pane>", "label"]}}. Empty means every request goes to HQ.
HUD_ORCHESTRATION=

# Where the database and uploaded images live. The plugin sets this to its
# state directory, so your answers survive reinstalls. Leave empty.
HUD_DATA_DIR=
